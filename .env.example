# Chiave TMDB (facoltativa: se vuota si inserisce dalla pagina al primo avvio)
# https://www.themoviedb.org/settings/api
# Va bene sia la "API Key" sia la "API Read Access Token"
TMDB_API_KEY=

# Porta su cui esporre l'app
PORT=8080

# Ogni quanti minuti aggiornare il catalogo
REFRESH_MINUTES=60

# Finestra delle "ultime uscite", in giorni
MOVIE_DAYS=90
TV_DAYS=30

# Piattaforme da mostrare (separate da virgola). Disponibili:
# netflix,prime,disney,paramount,sky,apple,timvision,raiplay,mediaset,discovery
PLATFORMS=netflix,prime,disney,paramount,sky,apple,timvision,raiplay,mediaset,discovery
