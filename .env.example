# Chiave TMDB (facoltativa: se vuota si inserisce dalla pagina al primo avvio)
# https://www.themoviedb.org/settings/api
# Va bene sia la "API Key" sia la "API Read Access Token"
TMDB_API_KEY=

# Porta su cui esporre l'app
PORT=8080

# Ogni quanti minuti aggiornare il catalogo
REFRESH_MINUTES=60

# Finestra delle "ultime uscite", in giorni
MOVIE_DAYS=90
TV_DAYS=30

# Quanti giorni avanti guarda la sezione "Prossimamente"
UPCOMING_DAYS=60

# "I migliori": voti di Rotten Tomatoes tramite OMDb (chiave gratuita su https://www.omdbapi.com/apikey.aspx).
# Si puo' inserire anche dal menu admin. Senza chiave la classifica usa i voti IMDb.
OMDB_API_KEY=
# Quanti anni indietro guarda "I migliori"
BEST_YEARS=10

# Piattaforme da mostrare (separate da virgola). Disponibili:
# netflix,prime,disney,paramount,sky,apple,timvision,raiplay,mediaset,discovery
PLATFORMS=netflix,prime,disney,paramount,sky,apple,timvision,raiplay,mediaset,discovery

# Richieste (facoltative): i film vanno a Radarr, le serie a Sonarr.
# Indirizzo e chiave API si trovano in Radarr/Sonarr > Settings > General.
RADARR_URL=
RADARR_API_KEY=
# Profilo di qualita' e cartella (nome o id). Se vuoti si usano i primi configurati.
RADARR_QUALITY_PROFILE=
RADARR_ROOT_FOLDER=
SONARR_URL=
SONARR_API_KEY=
SONARR_QUALITY_PROFILE=
SONARR_ROOT_FOLDER=

# PIN del menu admin (4-8 cifre). Se vuoto lo scegli dalla pagina la prima volta
# che apri l'ingranaggio in alto a destra.
ADMIN_PIN=

# Plex (facoltativo): segna i titoli che hai gia' e mostra stagioni ed episodi.
# Token: Plex Web > un film > ... > Ottieni informazioni > Visualizza XML > valore di X-Plex-Token nell'indirizzo
PLEX_URL=
PLEX_TOKEN=

# "Suggeriti per te" con l'AI (facoltativo). Si puo' impostare anche dal menu admin.
# Senza chiave si usano i titoli consigliati da TMDB.
# Servizio: anthropic (Claude) oppure openai (OpenRouter, OpenAI o altro servizio compatibile)
AI_PROVIDER=
# Claude: chiave da https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# OpenRouter / OpenAI: chiave e indirizzo (predefinito https://openrouter.ai/api/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Modello: con Claude claude-opus-5-5 (predefinito), claude-sonnet-5-5, claude-haiku-5-5;
# con OpenRouter il nome del modello, es. google/gemini-3-pro (obbligatorio)
AI_MODEL=

# Yamtrack (facoltativo): titoli gia' visti, per non suggerirli e capire meglio i gusti.
# Si puo' usare insieme a Plex o da solo: le fonti si scelgono nel menu admin (Gia' visti).
YAMTRACK_URL=
YAMTRACK_USER=
YAMTRACK_PASSWORD=
