# Chiave TMDB (facoltativa: se vuota si inserisce dalla pagina al primo avvio)
# https://www.themoviedb.org/settings/api
# Va bene sia la "API Key" sia la "API Read Access Token"
TMDB_API_KEY=

# Porta su cui esporre l'app
PORT=8080

# Ogni quanti minuti aggiornare il catalogo
REFRESH_MINUTES=60

# Finestra delle "ultime uscite", in giorni
MOVIE_DAYS=90
TV_DAYS=30

# Quanti giorni avanti guarda la sezione "Prossimamente"
UPCOMING_DAYS=60

# Piattaforme da mostrare (separate da virgola). Disponibili:
# netflix,prime,disney,paramount,sky,apple,timvision,raiplay,mediaset,discovery
PLATFORMS=netflix,prime,disney,paramount,sky,apple,timvision,raiplay,mediaset,discovery

# Richieste (facoltative): i film vanno a Radarr, le serie a Sonarr.
# Indirizzo e chiave API si trovano in Radarr/Sonarr > Settings > General.
RADARR_URL=
RADARR_API_KEY=
# Profilo di qualita' e cartella (nome o id). Se vuoti si usano i primi configurati.
RADARR_QUALITY_PROFILE=
RADARR_ROOT_FOLDER=
SONARR_URL=
SONARR_API_KEY=
SONARR_QUALITY_PROFILE=
SONARR_ROOT_FOLDER=

# PIN del menu admin (4-8 cifre). Se vuoto lo scegli dalla pagina la prima volta
# che apri l'ingranaggio in alto a destra.
ADMIN_PIN=

# Plex (facoltativo): segna i titoli che hai gia' e mostra stagioni ed episodi.
# Token: Plex Web > un film > ... > Ottieni informazioni > Visualizza XML > valore di X-Plex-Token nell'indirizzo
PLEX_URL=
PLEX_TOKEN=
